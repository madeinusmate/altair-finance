# Open Banking Configuration (Optional)
# Set NEXT_PUBLIC_OPEN_BANKING_ENABLED=true to enable open banking features
NEXT_PUBLIC_OPEN_BANKING_ENABLED=false

# Finverse API Credentials (Required when open banking is enabled)
FINVERSE_CLIENT_ID=your_client_id_here
FINVERSE_SECRET=your_client_secret_here
FINVERSE_APP_ID=your_app_id_here

# Application URL (for OAuth redirects)
# For Electron: Set to tunnel URL (e.g., https://your-tunnel.trycloudflare.com) or leave empty to auto-detect
# In production web: Set to your production URL
# In development: Leave empty to use tunnel URL (if available) or localhost
# NOTE: Finverse requires HTTPS for OAuth callbacks, so use a tunnel service for local development
NEXT_PUBLIC_APP_URL=

# Tunnel URL (auto-set by Electron, or set manually)
# This is automatically set when using cloudflared tunnel in Electron
# For manual setup: Run `cloudflared tunnel --url http://localhost:8528` and set this to the output URL
TUNNEL_URL=
