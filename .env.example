# Open Banking Configuration (Optional)
# Set NEXT_PUBLIC_OPEN_BANKING_ENABLED=true to enable open banking features
NEXT_PUBLIC_OPEN_BANKING_ENABLED=false

# Finverse API Credentials (Required when open banking is enabled)
FINVERSE_CLIENT_ID=your_client_id_here
FINVERSE_SECRET=your_client_secret_here
FINVERSE_APP_ID=your_app_id_here

# Application URL (for OAuth redirects)
# In production, this should be your production URL
# In development, defaults to http://localhost:8528
NEXT_PUBLIC_APP_URL=http://localhost:8528

# OAuth Redirect Relay URL (required for open banking)
# Deploy oauth-relay/ to Vercel and set this URL
# Example: https://netly-oauth-relay.vercel.app
# Or use your custom domain: https://auth.yourdomain.com
NEXT_PUBLIC_OAUTH_RELAY_URL=
