# Copy to .env.local. Do not put real secrets in this file.

# Open banking is optional. Leave this false until you have provider credentials.
NEXT_PUBLIC_OPEN_BANKING_ENABLED=false

# Finverse (only when open banking is enabled)
FINVERSE_CLIENT_ID=
FINVERSE_SECRET=
FINVERSE_APP_ID=

# Plaid (only when open banking is enabled)
# https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Loopback URL used when Electron has not set NETLY_APP_URL.
# pnpm dev binds 127.0.0.1:8527. The desktop app uses 8528-8535 and sets NETLY_APP_URL itself.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:8527

# Public HTTPS origin of the oauth-relay callback you host. No trailing path.
# Example: https://your-oauth-relay.example
NEXT_PUBLIC_OAUTH_RELAY_URL=

# Optional. Used only for PDF statement import.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
