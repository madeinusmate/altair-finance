#!/bin/sh
# $0 is the path used to start this script. When that path is the
# /usr/local/bin/netly symlink, dirname would be /usr/local/bin and the
# bundled Node and netly.mjs would be missed. Follow the link first.
self=$0
case $self in
*/*) ;;
*)
  self=$(
    IFS=:
    for dir in $PATH; do
      [ -z "$dir" ] && dir=.
      if [ -x "$dir/$0" ] || [ -L "$dir/$0" ]; then
        printf '%s\n' "$dir/$0"
        exit 0
      fi
    done
    exit 1
  ) || exit 1
  ;;
esac

while [ -L "$self" ]; do
  dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd) || exit 1
  link=$(readlink "$self") || exit 1
  case $link in
  /*) self=$link ;;
  *) self=$dir/$link ;;
  esac
done

ROOT=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd) || exit 1
NODE="$ROOT/node/arm64/node"
if [ ! -x "$NODE" ]; then
  NODE=$(command -v node) || exit 1
fi
exec "$NODE" "$ROOT/netly.mjs" "$@"
