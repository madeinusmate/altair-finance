#!/bin/sh
# Follow a symlink such as /usr/local/bin/netly before choosing the folder
# that contains netly.mjs.
self=$0
case $self in
*/*) ;;
*)
  self=$(
    IFS=:
    for dir in $PATH; do
      [ -z "$dir" ] && dir=.
      if [ -x "$dir/$0" ] || [ -L "$dir/$0" ]; then
        printf '%s\n' "$dir/$0"
        exit 0
      fi
    done
    exit 1
  ) || exit 1
  ;;
esac

while [ -L "$self" ]; do
  dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd) || exit 1
  link=$(readlink "$self") || exit 1
  case $link in
  /*) self=$link ;;
  *) self=$dir/$link ;;
  esac
done

DIR=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd) || exit 1
exec node "$DIR/netly.mjs" "$@"
